spring.cloud.config.enabled=false
spring.jackson.time-zone=<ZONA_HORARIA>

server.port=<PUERTO>

spring.datasource.url=jdbc:postgresql://<HOST>:<PUERTO>/<BASE_DATOS>
spring.datasource.username=<USUARIO>
spring.datasource.password=<CONTRASENA>
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.jakarta.persistence.query.timeout=600000

spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.max-lifetime=18800
spring.datasource.hikari.connection-timeout=5000
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.connection-test-query=SELECT 1

spring.flyway.locations=classpath:db/migration
spring.flyway.table=flyway_schema_history
spring.flyway.schemas=public
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

gestopago.auth.url=https://gestopago.portalventas.net
gestopago.auth.id-distribuidor=<ID_DISTRIBUIDOR>
gestopago.auth.codigo-dispositivo=<CODIGO_DISPOSITIVO>
gestopago.auth.password=${GESTOPAGO_AUTH_PASSWORD}
gestopago.auth.refresh-rate-ms=3600000

spring.cloud.openfeign.client.config.default.connect-timeout=5000
spring.cloud.openfeign.client.config.default.read-timeout=30000

gestopago.catalogo.cron=0 0 6 * * *
gestopago.catalogo.startup-delay-ms=3000

gestopago.crypto.secret-key=${GESTOPAGO_SECRET_KEY}
gestopago.crypto.iv=${GESTOPAGO_IV}
gestopago.tx.unidad=${GESTOPAGO_UNIDAD}
gestopago.tx.api-key=${GESTOPAGO_API_KEY}
gestopago.tx.monto-minimo=1.00
gestopago.tx.monto-maximo=10000.00
gestopago.tx.ventana-duplicado-segundos=60
gestopago.tx.codigos-pendientes=
gestopago.tx.conciliacion.habilitada=true
gestopago.tx.conciliacion.espera-minutos=5
gestopago.tx.conciliacion.max-intentos=5
gestopago.tx.conciliacion.intervalo-ms=300000
gestopago.tx.conciliacion.reenvio-mismo-upc=false
spring.cloud.openfeign.client.config.gestoPagoTx.connect-timeout=3000
spring.cloud.openfeign.client.config.gestoPagoTx.read-timeout=20000
spring.cloud.openfeign.client.config.gestoPagoTx.logger-level=none

app.jwt.secret=${JWT_SECRET}
spring.data.mongodb.uri=mongodb://<USUARIO>:<CONTRASENA>@<HOST>:<PUERTO>/<BASE_DATOS>?authSource=admin

springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always

logging.level.com.proyecto.servicios=INFO